  "components": [
    {
      "name": "Action principale",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Enregistrer ou poursuivre la transcription.",
      "html": "<button class=\"ds-primary\" type=\"button\">Enregistrer le brouillon</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:11px 15px;border-radius:7px;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:650;min-height:42px;cursor:pointer;transition:background .16s,color .16s;background:var(--green,#267c69);border:1px solid var(--green,#267c69);color:var(--white,#fff)}.ds-primary:hover:not(:disabled){background:var(--green-dark,#1b6554)}.ds-primary:focus-visible{outline:3px solid #b5843e;outline-offset:3px;}.ds-primary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Action secondaire",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Action complémentaire sans concurrencer la sauvegarde.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Nouvelle fiche</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:11px 15px;border-radius:7px;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:650;min-height:42px;cursor:pointer;transition:background .16s,color .16s;background:var(--white,#fff);border:1px solid #ccd7cc;color:var(--ink,#253c34)}.ds-secondary:hover:not(:disabled){background:var(--tint,#eaf2ed)}.ds-secondary:focus-visible{outline:3px solid #b5843e;outline-offset:3px;}.ds-secondary:disabled{opacity:.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Action textuelle",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Action légère à côté du contenu.",
      "html": "<button type=\"button\" class=\"ds-text\">Ouvrir les analyses</button>",
      "css": ".ds-text{display:inline-flex;align-items:center;gap:6px;border:0;background:transparent;color:var(--green,#267c69);font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600;padding:5px 0;cursor:pointer}.ds-text:hover{text-decoration:underline;text-underline-offset:4px}.ds-text:focus-visible{outline:3px solid #b5843e;outline-offset:3px;}"
    },
    {
      "name": "Référence papier",
      "kind": "input",
      "refersTo": "input",
      "description": "Un champ natif avec son label toujours visible.",
      "html": "<label class=\"ds-field\" for=\"ds-paper-ref\">Référence du questionnaire<input id=\"ds-paper-ref\" value=\"E-001\" maxlength=\"50\"></label>",
      "css": ".ds-field{display:grid;gap:9px;font-family:'DM Sans',sans-serif;font-size:11px;color:var(--ink,#253c34)}.ds-field input{max-width:100%;min-width:0;border:1px solid #cdd7cd;border-radius:7px;background:var(--white,#fff);color:var(--ink,#253c34);padding:11px 12px;font:600 13px 'DM Sans',sans-serif;letter-spacing:.04em;caret-color:var(--green,#267c69)}.ds-field input:focus-visible{outline:3px solid #b5843e;outline-offset:3px;}"
    },
    {
      "name": "Navigation de travail",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Destination active claire dans une navigation forêt.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navigation principale\"><button class=\"ds-nav-item ds-current\" aria-current=\"page\" type=\"button\">Saisir une réponse</button><button class=\"ds-nav-item\" type=\"button\">Les réponses</button></nav>",
      "css": ".ds-nav{display:grid;gap:6px;background:var(--forest,#203f34);padding:16px;width:220px;border-radius:7px}.ds-nav-item{display:flex;align-items:center;gap:12px;padding:13px 12px;background:transparent;border:0;color:#c7d7c9;text-align:left;font:400 13px 'DM Sans',sans-serif;border-radius:7px;cursor:pointer}.ds-nav-item:hover{background:#2c4b3e;color:#fff}.ds-nav-item.ds-current{background:#edf2e5;color:#204b3a;font-weight:650}.ds-nav-item:focus-visible{outline:3px solid #b5843e;outline-offset:3px;}"
    },
    {
      "name": "État à compléter",
      "kind": "chip",
      "refersTo": "status-draft",
      "description": "Le statut de brouillon reste écrit et illustré.",
      "html": "<span class=\"ds-status\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m16 3 5 5-12 12-6 1 1-6Z\"/><path d=\"m14 5 5 5\"/></svg>À compléter</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:5px;font:400 10px 'DM Sans',sans-serif;border-radius:4px;padding:3px 7px;white-space:nowrap;background:#f5eddd;color:#8e652a}"
    },
    {
      "name": "Panneau de travail",
      "kind": "card",
      "refersTo": "card",
      "description": "Surface principale plane, avec filets plutôt que relief.",
      "html": "<section class=\"ds-card\"><h2>Informations générales</h2><p>Respecte les réponses du papier.</p></section>",
      "css": ".ds-card{background:var(--white,#fff);color:var(--ink,#253c34);border:1px solid var(--line,#dfe5dd);border-radius:var(--radius,12px);padding:23px 25px}.ds-card h2{font:700 17px/1.5 'Manrope',sans-serif;margin:0}.ds-card p{font:400 11px/1.65 'DM Sans',sans-serif;color:var(--muted,#69756d);margin:6px 0 0;max-width:65ch}"
    },
    {
      "name": "Réponse sélectionnée",
      "kind": "input",
      "refersTo": "answer-option-selected",
      "description": "Une option garde le contrôle natif et un libellé complet.",
      "html": "<label class=\"ds-option\"><input type=\"radio\" name=\"ds-answer\" checked><span>Tout à fait d’accord</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg></label>",
      "css": ".ds-option{display:inline-flex;align-items:center;gap:8px;border:1px solid #79a58b;min-height:39px;border-radius:6px;padding:8px 11px;font:400 11px/1.4 'DM Sans',sans-serif;cursor:pointer;background:#edf5ec;color:#204f3a}.ds-option:hover{background:#f4f7f1}.ds-option input{accent-color:var(--green,#267c69);width:13px;height:13px;margin:0;flex-shrink:0}.ds-option input:focus-visible{outline:3px solid #b5843e;outline-offset:3px;}.ds-option svg{margin-left:auto}"
    },
